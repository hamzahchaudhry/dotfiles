{
  "vim_mode": true,
  "disable_ai": true,
  "show_whitespaces": "trailing",
  "tab_size": 2,
  "format_on_save": "on",
  "cli_default_open_behavior": "new_window",
  "collaboration_panel": {
    "button": false,
  },
  "agent": {
    "button": false,
  },
  "debugger": {
    "button": false,
  },
  "search": {
    "button": false,
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "status_bar": {
    "cursor_position_button": false,
  },
  "title_bar": {
    "show_user_menu": false,
    "show_branch_status_icon": true,
    "show_sign_in": false,
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },
  "tab_bar": {
    "show_tab_bar_buttons": false,
    "show_nav_history_buttons": false,
  },
  "project_panel": {
    "git_status_indicator": true,
    "indent_size": 16.0,
    "entry_spacing": "standard",
    "default_width": 160.0,
    "dock": "left",
    "button": false,
  },
  "code_lens": "on",
  "inlay_hints": {
    "enabled": true,
    "show_background": true,
  },
  "colorize_brackets": true,
  "indent_guides": {
    "coloring": "indent_aware",
  },
  "toolbar": {
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": false,
  },
  "gutter": {
    "min_line_number_digits": 3,
  },
  "rounded_selection": false,
  "unnecessary_code_fade": 0.5,
  "buffer_line_height": "standard",
  "buffer_font_family": "JetBrainsMonoNL Nerd Font Mono",
  "terminal": {
    "button": false,
    "font_family": "JetBrainsMonoNL Nerd Font Mono",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme"
  },
  "buffer_font_size": 12.0,
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    "dark": "Ayu Dark"
  },

  "lsp": {
    "pyrefly": {
      "binary": {
        "path": "/usr/bin/pyrefly",
        "arguments": ["lsp"],
      },
    },
    "ruff": {
      "binary": {
        "path": "/usr/bin/ruff",
        "arguments": ["server"],
      },
    },
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy",
          "extraArgs": ["--", "-D", "clippy::pedantic"],
        },
      },
    },
  },
  "languages": {
    "Python": {
      "language_servers": ["pyrefly", "ruff"],
    },
  },
}
