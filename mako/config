width=500
border-radius=12
background-color=#000000
font=JetBrainsMonoNL Nerd Font 12
format=<span size="large"><b>%s</b></span>\n<span foreground="#bac2de">%b</span>
icon-path=/usr/share/icons/AdwaitaLegacy
default-timeout=5000
group-by=app-name,summary

[grouped]
format=<span size="large"><b>%s</b></span> <span foreground="#9399b2">(%g)</span>\n<span foreground="#bac2de">%b</span>

[category=on]
border-color=#77dd77
default-timeout=1200

[category=off]
border-color=#ff6961
default-timeout=1200

[category=tasks]
border-color=#91ddf2

[urgency=critical]
border-color=#ff0000
default-timeout=20000
