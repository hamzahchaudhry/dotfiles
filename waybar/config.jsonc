// -*- mode: jsonc -*-
{
  "position": "bottom",

  "modules-left": ["group/traym", "custom/tasks", "mango/workspaces"],

  "modules-right": ["idle_inhibitor", "cpu", "temperature", "memory", "privacy", "wireplumber", "backlight", "battery", "clock"],

  // left
  "group/traym": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 0
    },
    "modules": ["custom/trayicon", "tray"]
  },

  "custom/trayicon": {
    "format": "",
    "tooltip": false
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  "custom/tasks": {
    "interval": 300,
    "exec": "~/.config/waybar/scripts/tasks.sh",
    "return-type": "json",
    "on-click": "footclient --app-id taskterm sh -c 'task next; exec \"$SHELL\"'"
  },

  "mango/workspaces": {
    "format": "{icon}",
    "hide-empty": true,
    "on-click": "activate",
    "on-click-right": "toggle"
  },

  // right: system
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": " ",
      "deactivated": " "
    }
  },

  "cpu": {
    "format": " {usage}%   {avg_frequency}GHz",
    "states": { "warning": 80, "critical": 90 },
    "on-click": "footclient btop"
  },

  "temperature": {
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "warning-threshold": 80,
    "critical-threshold": 90,
    "format": "{icon} {temperatureC}°",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "CPU package: {temperatureC}°C",
    "on-click": "footclient btop"
  },

  "memory": {
    "format": " {used:0.1f}GiB  󰾵 {swapUsed:0.1f}GiB",
    "tooltip": false,
    "on-click": "footclient btop"
  },

  // right: media and controls
  "privacy": {
    "icon-size": 14
  },

  "wireplumber": {
    "format": "{volume}% {icon} {format_source}",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-muted": "󰖁 {format_source}",
    "format-source": " {volume}%",
    "format-source-muted": " ",
    "format-icons": {
      "headphone": " ",
      "default": [" ", " ", " "]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "tooltip": false,
    "max-volume": 150
  },

  "backlight": {
    "interval": 300,
    "format": "{icon} {percent}%",
    "format-icons": ["󱩎", "󱩑", "󱩓", "󱩕", "󰛨"]
  },

  "battery": {
    "states": { "low": 20 },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-full": " {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "Power: {power} W\nTime: {time}\nHealth: {health}%\nCycles: {cycles}"
  },

  "clock": {
    "timezone": "Etc/GMT+7",
    "format": "{:%a, %m-%d %I:%M %p}",
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
  }
}
