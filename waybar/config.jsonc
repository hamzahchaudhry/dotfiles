{
  "position": "bottom",

  "modules-left": ["group/traym", "custom/tasks", "mango/workspaces"],

  "modules-right": ["idle_inhibitor", "cpu", "temperature", "battery#power", "memory", "privacy", "wireplumber", "backlight", "battery", "clock"],

  "group/traym": {
    "orientation": "horizontal",
    "drawer": { "transition-duration": 0 },
    "modules": ["custom/trayicon", "tray"]
  },

  "custom/trayicon": { "format": "", "tooltip": false },

  "tray": { "spacing": 8 },

  "custom/tasks": {
    "interval": 300,
    "exec": "~/.config/waybar/scripts/tasks.sh",
    "return-type": "json",
    "on-click": "footclient --app-id taskterm sh -c 'task next; exec \"$SHELL\"'"
  },

  "mango/workspaces": { "hide-empty": true, "on-click": "activate" },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": { "activated": " ", "deactivated": " " }
  },

  "cpu": {
    "format": " {usage}%   {avg_frequency}GHz",
    "on-click": "footclient btop"
  },

  "temperature": {
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "warning-threshold": 80,
    "critical-threshold": 90,
    "format": "{icon} {temperatureC}°",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "CPU package: {temperatureC}°C",
    "on-click": "footclient btop"
  },

  "memory": {
    "format": " {used:0.1f}GiB  󰾵 {swapUsed:0.1f}GiB",
    "tooltip": false,
    "on-click": "footclient btop"
  },

  "battery#power": {
    "format": " {power:.1f}W",
    "tooltip": false,
    "on-click": "footclient btop"
  },

  "privacy": { "icon-size": 14 },

  "wireplumber": {
    "format": "{volume}% {icon} {format_source}",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-muted": "󰖁 {format_source}",
    "format-source": " {volume}%",
    "format-source-muted": " ",
    "format-icons": { "headphone": " ", "default": [" ", " ", " "] },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "tooltip": false,
    "max-volume": 150
  },

  "backlight": {
    "interval": 300,
    "format": "{icon} {percent}%",
    "format-icons": ["󱩎", "󱩑", "󱩓", "󱩕", "󰛨"]
  },

  "battery": {
    "states": { "low": 20 },
    "events": { "on-discharging-low": "~/.config/waybar/scripts/low-battery.sh" },
    "format": "{icon} {capacity}%",
    "format-icons": {
      "charging": "",
      "plugged": "",
      "full": "",
      "default": ["", "", "", "", ""]
    },
    "tooltip-format": "Time: {time}\nHealth: {health}%\nCycles: {cycles}"
  },

  "clock": {
    "timezone": "Etc/GMT+7",
    "format": "{:%a, %m-%d %I:%M %p}",
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
  }
}
